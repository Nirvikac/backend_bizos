PORT=3000

# NOTE: Never commit real secrets. Copy this file to .env and fill in the
# real values there (.env is gitignored).
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/user
JWT_SECRETS=<your-jwt-secret>
EMAIL_USER=<your-gmail-address>
EMAIL_APP_PASS=<your-gmail-app-password>
BACKEND_URL=https://backend-bizos.onrender.com

# Transactional email — RECOMMENDED for cloud hosts like Render (Gmail SMTP is
# blocked/throttled from datacenter IPs). Get a free key at resend.com.
# For the sandbox, RESEND_FROM=onboarding@resend.dev and you can only send to
# the email you signed up with. Verify a domain (e.g. mail.yourdomain.com) to
# send to real users.
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM=onboarding@resend.dev
