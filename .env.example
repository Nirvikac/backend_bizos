PORT=3000

# NOTE: Never commit real secrets. Copy this file to .env and fill in the
# real values there (.env is gitignored).
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/user
JWT_SECRETS=<your-jwt-secret>
EMAIL_USER=<your-gmail-address>
EMAIL_APP_PASS=<your-gmail-app-password>
BACKEND_URL=https://backend-bizos.onrender.com
